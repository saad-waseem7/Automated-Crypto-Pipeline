# Copy to .env and change every value. Never commit .env.
# These are examples only and are intentionally weak placeholders.

# Bearer token for POST /reload on the API (16 characters minimum).
RELOAD_TOKEN=change-me-reload-token

# Postgres credentials, used for the Airflow metadata database.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=airflow

# Airflow encryption key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me-generate-a-real-fernet-key
# Signing secret for Airflow 3 task-to-API tokens (any long random string).
AIRFLOW_JWT_SECRET=change-me-long-random-string
